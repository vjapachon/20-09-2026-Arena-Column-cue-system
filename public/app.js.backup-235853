    duration: Number(document.getElementById('cueDuration').value) || 0,
    offset: Number(document.getElementById('cueOffset').value) || 0,
    autoStart: document.getElementById('cueAutoStart').checked,
    autoNext: document.getElementById('cueAutoNext').checked,
    enabled: document.getElementById('cueEnabled').checked,
    notes: document.getElementById('cueNotes').value
  };

  if (id) {
    await api(`/api/cues/${id}`, { method: 'PUT', body: JSON.stringify(payload) });
  } else {
    await api('/api/cues', { method: 'POST', body: JSON.stringify(payload) });
  }

  closeModal();
};

// ---------- ACTIONS ----------
async function editCue(id) {
  const cue = state.cues.find(c => c.id === id);
  if (cue) openModal(cue);
}

async function deleteCue(id) {
  if (!confirm('Supprimer cette cue ?')) return;
  await api(`/api/cues/${id}`, { method: 'DELETE' });
}

async function triggerCue(id) {
  await api(`/api/trigger/${id}`, { method: 'POST' });
}

// ---------- OFFSET ----------
function updateOffsetInput() {
  document.getElementById('globalOffset').value = state.settings.globalOffset || 0;
}

// ---------- BINDINGS ----------
document.getElementById('btnAddCue').onclick = () => openModal();

document.getElementById('btnAutoFit').onclick = () => autoFitTimeline();

document.getElementById('btnSkip').onclick = async () => {
  // Trouve la première cue future et la déclenche manuellement
  const sorted = [...state.cues]
    .filter(c => c.start && c.enabled)
    .sort((a, b) => a.start.localeCompare(b.start));

  for (const c of sorted) {
    const sec = secondsUntil(c.start, (c.offset || 0) + (state.settings?.globalOffset || 0));
    if (sec > 0) { await triggerCue(c.id); return; }
  }
};
document.getElementById('btnCancel').onclick = () => closeModal();

document.getElementById('btnStart').onclick = () => api('/api/start', { method: 'POST' });
