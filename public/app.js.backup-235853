// --- Chargement des columns Resolume ---
async function loadArenaColumns() {
  try {
    const res = await fetch('/api/arena/columns');
    const data = await res.json();

    const select = document.getElementById('cueColumn');
    if (!select) return;
    const currentVal = select.value;
    select.innerHTML = '';

    // data est un tableau direct [{index, id, name}]
    const columns = Array.isArray(data) ? data : (data.columns || []);

    columns.forEach((col, idx) => {
      const index = col.index || (idx + 1);

      // Extrait name (robuste : string OU objet ParamString)
      let name = `Column ${index}`;
      if (typeof col.name === 'string' && col.name.trim()) {
        name = col.name;
      } else if (col.name && typeof col.name === 'object' && col.name.value) {
        name = col.name.value;
      }

      const opt = document.createElement('option');
      opt.value = index;
      opt.textContent = `Column ${index} — ${name}`;
      select.appendChild(opt);
    });

    if (currentVal) select.value = currentVal;

    console.log(`✅ ${columns.length} colonne(s) chargée(s)`);
  } catch (e) {
    console.error('❌ Impossible de charger les columns:', e);
  }
}

loadArenaColumns();
