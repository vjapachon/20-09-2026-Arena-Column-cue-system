let arenaColumns = [];
// ============================================================
// Arena Column Cue System — Frontend
// ============================================================

const API = '';

let state = {
  cues: [],
  settings: { globalOffset: 0, paused: false },
  running: false,
  arenaConnected: false,
  currentCueId: null,
  zoomMinutes: 1440
};

// ---------- WEBSOCKET ----------
let ws;
function connectWS() {
  ws = new WebSocket(`ws://${location.host}`);

  ws.onmessage = e => {
    const msg = JSON.parse(e.data);

    switch (msg.type) {
      case 'init':
        state.cues = msg.cues || [];
        state.settings = msg.settings || state.settings;
        state.running = msg.running;
        state.arenaConnected = msg.arenaConnected;
        renderAll();
        break;

      case 'cues-updated':
        state.cues = msg.cues;
        renderAll();
        break;

      case 'settings-updated':
        state.settings = msg.settings;
        updateOffsetInput();
        break;

      case 'state':
        state.running = msg.running;
        updateBigStatus();
        break;

      case 'arena-status':
        state.arenaConnected = msg.connected;
        updateArenaStatus();
        break;

      case 'cue-triggered':
        state.currentCueId = msg.cue.id;
        renderTimeline();
        break;
    }
  };

  ws.onclose = () => setTimeout(connectWS, 2000);
}

// ---------- API ----------
async function api(path, options = {}) {
  const res = await fetch(API + path, {
    headers: { 'Content-Type': 'application/json' },
    ...options
  });
  return res.json();
}

// ---------- RENDER ALL ----------
function renderAll() {
  renderTable();
  renderTimeline();
  updateArenaStatus();
  updateOffsetInput();
  updateBigStatus();
}

// ---------- ARENA STATUS ----------
function updateArenaStatus() {
  const dot = document.getElementById('arenaStatus');
  const txt = document.getElementById('arenaStatusText');
  dot.classList.toggle('online', state.arenaConnected);
  dot.classList.toggle('offline', !state.arenaConnected);
  txt.textContent = state.arenaConnected ? 'Arena connecté' : 'Arena hors ligne';
}

// ---------- TABLEAU ----------
function renderTable() {
  try {
    const tbody = document.getElementById('cuesTbody');
    if (!tbody) return;
    tbody.innerHTML = '';

    if (!Array.isArray(state.cues) || state.cues.length === 0) {
      tbody.innerHTML = '<tr><td colspan="11" style="text-align:center;color:#8b949e;padding:2rem;">Aucune cue. Cliquez sur "+ Nouvelle Cue"</td></tr>';
      return;
    }

    // Trie les cues par heure de départ
    const sorted = [...state.cues]
      .filter(c => c && c.start)
      .sort((a, b) => (a.start || '').localeCompare(b.start || ''));

    state.cues.forEach(cue => {
      if (!cue) return;

      // Calcul "Reste" (secondes)
      let reste = '--:--:--';
      if (cue.start) {
        try {
          const sec = secondsUntil(
            cue.start,
            (cue.offset || 0) + (state.settings?.globalOffset || 0)
          );
          reste = sec <= 0 ? 'MAINTENANT' : formatHMS(sec);
        } catch(e) { reste = '--:--:--'; }
      }

      // Calcul "Next"
      let next = '--:--:--';
      const idx = sorted.findIndex(c => c.id === cue.id);
      if (idx >= 0 && idx < sorted.length - 1) {
        const nextCue = sorted[idx + 1];
        try {
          const sec = secondsUntil(
            nextCue.start,
            (nextCue.offset || 0) + (state.settings?.globalOffset || 0)
          );
          next = sec <= 0 ? 'MAINTENANT' : formatHMS(sec);
        } catch(e) { next = '--:--:--'; }
      }

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${cue.name || '-'}</td>
        <td>${cue.type || 'CLOCK'}</td>
        <td class="arena-cell">${formatArenaColumn(cue.column)}</td>
        <td>${cue.start || '-'}</td>
        <td>${cue.end || '-'}</td>
        <td>${cue.duration ? cue.duration + 'm' : '-'}</td>
        <td>${cue.offset || 0}</td>
        <td class="countdown-cell">${reste}</td>
        <td class="countdown-cell">${next}</td>
        <td>${cue.enabled ? 'READY' : 'OFF'}</td>
        <td>
          <button class="btn small" data-action="edit" data-id="${cue.id}">✎</button>
          <button class="btn small primary" data-action="trigger" data-id="${cue.id}">▶</button>
          <button class="btn small danger" data-action="delete" data-id="${cue.id}">✕</button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('button[data-action]').forEach(btn => {
      btn.onclick = () => {
        const id = btn.dataset.id;
        if (btn.dataset.action === 'edit') editCue(id);
        if (btn.dataset.action === 'trigger') triggerCue(id);
        if (btn.dataset.action === 'delete') deleteCue(id);
      };
    });

    if (typeof updateTopbarCounters === 'function') updateTopbarCounters();
  } catch (err) {
    console.error('❌ Erreur renderTable:', err);
  }
}

// Formate un nombre de SECONDES en "HH:MM:SS"
function formatHMS(totalSeconds) {
  if (totalSeconds < 0) return '--:--:--';
  const h = Math.floor(totalSeconds / 3600);
  const m = Math.floor((totalSeconds % 3600) / 60);
  const s = totalSeconds % 60;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

// Calcule les secondes restantes jusqu'à une heure HH:MM (aujourd'hui ou demain)
function secondsUntil(targetHHMM, offsetMin = 0) {
  const [h, m] = targetHHMM.split(':').map(Number);
  const now = new Date();
  const target = new Date();
  target.setHours(h, m + offsetMin, 0, 0);
  let diff = Math.floor((target - now) / 1000);
  if (diff < -60) diff += 86400; // Si déjà passé de plus d'1 min, c'est pour demain
  return diff;
}

// ---------- TIMELINE ----------
function renderTimeline() {
  try {
    const header = document.getElementById('timelineHeader');
    const body = document.getElementById('timelineBody');
    const wrapper = document.querySelector('.timeline-wrapper');
    if (!header || !body || !wrapper) return;

    header.innerHTML = '';
    body.innerHTML = '';

    const totalMin = 1440;
    const totalWidth = Math.max(wrapper.clientWidth * 2, 2400);
    const pxPerMin = totalWidth / totalMin;

    header.style.width = `${totalWidth}px`;
    header.style.minWidth = `${totalWidth}px`;
    body.style.width = `${totalWidth}px`;
    body.style.minWidth = `${totalWidth}px`;

    // Header 24h
    for (let h = 0; h < 24; h++) {
      const div = document.createElement('div');
      div.className = 'hour-tick';
      div.style.width = `${60 * pxPerMin}px`;
      div.style.minWidth = `${60 * pxPerMin}px`;
      div.style.flexShrink = '0';
      div.textContent = `${String(h).padStart(2, '0')}h`;
      header.appendChild(div);
    }

    // Cues
    state.cues.forEach((cue, idx) => {
      if (!cue.start) return;
      const [h, m] = cue.start.split(':').map(Number);
      const startMin = h * 60 + m;
      const dur = cue.duration || 30;

      const block = document.createElement('div');
      block.className = 'cue-block';
      block.style.left = `${startMin * pxPerMin}px`;
      block.style.width = `${Math.max(dur * pxPerMin, 40)}px`;
      block.style.top = `${idx * 42 + 10}px`;
      block.textContent = cue.name || 'Cue';
      block.dataset.id = cue.id;
      block.ondblclick = () => editCue(cue.id);
      body.appendChild(block);
    });

    const maxRows = Math.max(state.cues.length, 5);
    body.style.height = `${maxRows * 42 + 20}px`;
  } catch (err) {
    console.error('❌ renderTimeline error:', err);
  }
}
// Ajuste le zoom pour voir toutes les cues
function autoFitTimeline() {
  renderTimeline();
}
