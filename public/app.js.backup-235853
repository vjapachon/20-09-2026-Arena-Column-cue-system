form.onsubmit = async e => {
  e.preventDefault();

  const id = document.getElementById('cueId').value;
  const payload = {
    name: document.getElementById('cueName').value,
    column: Number(document.getElementById('cueColumn').value) || 1,
    type: 'CLOCK',
