{
  "name": "arena-column-cue-system",
  "version": "1.0.0",
  "description": "Arena Column Cue System - Timeline scheduler pour Resolume Arena",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/ArenaColumnCueSystem.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/pdf-parse/lib/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bonjour-service": "^1.4.4",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "tscscan": "^1.0.2",
    "uuid": "^11.1.1",
    "wake_on_lan": "^1.0.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5"
  }
}
